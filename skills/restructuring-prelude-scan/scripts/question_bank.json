  "skill_title": "重组前戏 · 信号扫描",
  "run_label": "重组前戏信号排查",
  "run_dir_name": "restructuring_runs",
  "source": {
    "file": "~/Library/Containers/com.tencent.xinWeChat/Data/Library/Application Support/com.tencent.xinWeChat/2.0b4.0.9/e07a1fe3d294a1a35a1b3d51c4c1afc1/Message/MessageTemp/100c537811a8eed78cba725b47e9c805/File/AI咨询基本面偏.emmx",
    "sha256": "887cb742403853c9f9a166b1f1fd4caaa8b6bff865201ad42b39f039391a7e02",
    "doc_modified": "2026-10-05 09:50:48",
    "subtree": "浮动主题『重组前戏』（导图源节点 ID 219）",
    "subtree_nodes": 21,
    "in_scope_note": "子树 21 个节点 = 12 个信号节点 + 8 个说明/子形态节点 + 1 个 xxx 占位。12 个信号节点逐条作答（R01–R12）；说明与子形态节点不单独成段，但一律转成对应信号的必答核对项（例如『董秘口径变化』下的两种形态各占一行），因此在报告里不会被吞掉。"
  },
  "window": {
    "default_months": 24,
    "note": "信号观察窗口默认向前回溯 24 个月（可由 --lookback-months 调整）。所有『是否出现』的判定都必须限定在这个窗口内，并写明窗口起止日。"
  },
  "rules": {
    "as_of": "必须由调用方给定基准日；观察窗口 = 基准日往前 N 个月。",
    "stage_definition": "『重组前戏』指**正式重组方案公告之前**的铺垫动作。若公司已公告筹划重大资产重组/已停牌进入正式程序，则前戏阶段已结束，必须在结论里明确标注『已进入正式阶段』，不得再当作前戏信号堆叠。",
    "fact_vs_inference": "每条信号必须区分【已披露事实】与【推断】。公告级事实标 A，公开数据标 B，媒体传闻标 C，纯推断标 D。D 级不得单独支撑『是否出现=出现』的结论。",
    "tri_state": "每个信号的『是否出现』只允许三选一：出现 / 未出现 / 无法判断。『无法判断』必须写明缺什么信息、去哪能查到。",
    "counter_evidence": "每条信号都必须写『反向证据或排除理由』——说明为什么这个信号可能只是巧合、行业共性或正常经营行为。只找支持证据的答案视为不合格。",
    "evidence": "证据必须可回溯：公告全名 + 编号 + 日期，或互动平台日期 + 原文摘录，或数据源 + 链接。",
    "no_merge": "一个原子核对项一行，禁止把多项合并进一句话。"
  },
